  <diagram id="pi-task-execution" name="智能体执行流程">
    <mxGraphModel dx="2200" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="720" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="智能体执行流程" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=32;fontStyle=1;fontColor=#243447;" vertex="1" parent="1">
          <mxGeometry x="50" y="28" width="2100" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="任务在上下文、规划、执行、验证、审查和交付之间闭环推进；失败只返回到必要环节" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#243447;" vertex="1" parent="1">
          <mxGeometry x="52" y="78" width="2096" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1  建立任务契约&lt;/b&gt;&lt;br&gt;&lt;br&gt;解析目标、范围与验收标准&lt;br&gt;识别数据、权限与执行风险&lt;br&gt;确认责任人、审批策略和检查点&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;任务单 · 风险等级 · 检查点&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="150" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sa1" value="" style="rounded=1;arcSize=8;fillColor=#003894;strokeColor=#003894;" vertex="1" parent="1">
          <mxGeometry x="120" y="150" width="430" height="8" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2  构建任务上下文&lt;/b&gt;&lt;br&gt;&lt;br&gt;通过受控连接层获取需求、代码与历史&lt;br&gt;标记来源、版本与信息缺口&lt;br&gt;形成可追溯的上下文包&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;上下文包 · 信息缺口清单&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="150" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sa2" value="" style="rounded=1;arcSize=8;fillColor=#003894;strokeColor=#003894;" vertex="1" parent="1">
          <mxGeometry x="630" y="150" width="430" height="8" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3  规划与智能体编排&lt;/b&gt;&lt;br&gt;&lt;br&gt;拆解步骤、依赖与完成条件&lt;br&gt;选择专业智能体、模型与工具&lt;br&gt;设定质量阈值、预算与降级策略&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;可执行计划 · 质量阈值&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="150" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="sa3" value="" style="rounded=1;arcSize=8;fillColor=#003894;strokeColor=#003894;" vertex="1" parent="1">
          <mxGeometry x="1140" y="150" width="430" height="8" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4  隔离环境执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;创建受控分支与执行沙箱&lt;br&gt;实施代码、配置与文档变更&lt;br&gt;记录工具调用、关键决策与状态&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;候选变更集 · 决策记录&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
