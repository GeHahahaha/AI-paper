          <mxGeometry x="1650" y="150" width="430" height="8" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5  自动验证与修复&lt;/b&gt;&lt;br&gt;&lt;br&gt;执行测试、静态与安全检查&lt;br&gt;失败自动归因、修复与复测&lt;br&gt;持续失败或越界时升级人工接管&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;测试报告 · 验证证据&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
