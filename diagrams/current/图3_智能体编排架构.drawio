        <mxCell id="subtitle" value="主控 Agent 维护任务状态和检查点，专业 Agent 按角色执行，共享上下文、策略、模型、工具和证据底座" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5F6F7F;" vertex="1" parent="1"><mxGeometry x="47" y="70" width="1600" height="30" as="geometry"/></mxCell>

