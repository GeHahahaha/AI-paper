        <mxCell id="phase0" value="&lt;b&gt;0　任务受理&lt;/b&gt;&lt;br&gt;&lt;br&gt;明确目标、范围、优先级&lt;br&gt;完成风险分类和任务契约&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：任务单 / 风险等级&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#788B9C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#2B4156;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="255" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase1" value="&lt;b&gt;1　需求分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;获取业务与项目上下文&lt;br&gt;澄清需求、约束和验收条件&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：需求说明 / 验收标准&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="525" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase2" value="&lt;b&gt;2　方案设计&lt;/b&gt;&lt;br&gt;&lt;br&gt;分析变更影响与技术风险&lt;br&gt;设计架构、接口与数据方案&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：设计方案 / 实施计划&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="795" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase3" value="&lt;b&gt;3　开发实施&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务拆分与专业智能体编排&lt;br&gt;在受控分支和沙箱中实施&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：代码 / 配置 / 文档&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1065" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase4" value="&lt;b&gt;4　测试验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;执行单元、集成与安全测试&lt;br&gt;失败自动归因、修复和复测&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：测试报告 / 证据包&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1335" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase5" value="&lt;b&gt;5　审查验收&lt;/b&gt;&lt;br&gt;&lt;br&gt;提交触发 / 定时全量代码审核&lt;br&gt;独立审查、整改与质量验收&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：审查结论 / 验收记录&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1605" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase6" value="&lt;b&gt;6　发布交付&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成合并请求、变更及回滚材料&lt;br&gt;审批后触发现有发布流水线&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：交付包 / 发布记录&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEA;strokeColor=#B75E55;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#743C37;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1875" y="305" width="235" height="245" as="geometry"/></mxCell>
        <mxCell id="phase7" value="&lt;b&gt;7　运行反馈&lt;/b&gt;&lt;br&gt;&lt;br&gt;观测健康、日志、指标和告警&lt;br&gt;异常归因、复盘并沉淀能力&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;产物：运行证据 / 改进任务&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#80659B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#574168;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="2145" y="305" width="235" height="245" as="geometry"/></mxCell>

