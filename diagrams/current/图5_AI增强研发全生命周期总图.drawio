        <mxCell id="pi-support-label" value="智能执行中枢" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#315B3B;strokeColor=#315B3B;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="635" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="pi-support" value="&lt;b&gt;理解目标 → 构建上下文 → 规划与智能体编排 → 工具执行 → 确定性校验 → 定向返工 → 证据汇总&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#4E6755&quot;&gt;阶段之间以结构化工件交接；完成条件由实际变更、测试、独立审查与人工责任状态共同证明&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="255" y="635" width="2190" height="120" as="geometry"/></mxCell>

        <mxCell id="mcp-label" value="受控连接层" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#365D73;strokeColor=#365D73;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="780" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;项目与知识　｜　代码仓库　｜　构建与测试　｜　质量与安全　｜　发布与制品　｜　日志、指标、告警与工单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#4A6675&quot;&gt;统一实施工具发现、参数校验、最小权限、凭据托管、读写白名单、调用审计与状态回写&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4EEF3;strokeColor=#557D91;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274B5E;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="255" y="780" width="2190" height="120" as="geometry"/></mxCell>

