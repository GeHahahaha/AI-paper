        <mxCell id="sdlc-label" value="传统研发生命周期" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#233B53;strokeColor=#233B53;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
