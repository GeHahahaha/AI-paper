        <mxCell id="g1" value="&lt;b&gt;数据边界&lt;/b&gt;&lt;br&gt;分类分级 · 脱敏 · 上下文最小化" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F0F6;strokeColor=#9A789A;fontFamily=Microsoft YaHei;fontColor=#584058;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="255" y="925" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="g2" value="&lt;b&gt;权限与执行边界&lt;/b&gt;&lt;br&gt;最小权限 · 限时授权 · 沙箱 · 白名单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F0F6;strokeColor=#9A789A;fontFamily=Microsoft YaHei;fontColor=#584058;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="685" y="925" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="g3" value="&lt;b&gt;质量与责任边界&lt;/b&gt;&lt;br&gt;验收阈值 · 独立审查 · 人工审批" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F0F6;strokeColor=#9A789A;fontFamily=Microsoft YaHei;fontColor=#584058;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1115" y="925" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="g4" value="&lt;b&gt;可观测与审计&lt;/b&gt;&lt;br&gt;调用、产物、证据与决策全程留痕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F0F6;strokeColor=#9A789A;fontFamily=Microsoft YaHei;fontColor=#584058;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1545" y="925" width="410" height="145" as="geometry"/></mxCell>
