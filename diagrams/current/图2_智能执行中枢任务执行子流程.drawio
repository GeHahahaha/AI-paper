<mxfile host="app.diagrams.net" modified="2026-08-11T08:20:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="task-execution" name="智能执行中枢任务执行子流程">
    <mxGraphModel dx="1700" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="智能执行中枢任务执行子流程" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;fontColor=#233B53;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="800" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="展示一个研发任务进入智能执行中枢后，如何完成上下文构建、规划、执行、验证、审查、交付和能力沉淀" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5F6F7F;" vertex="1" parent="1"><mxGeometry x="47" y="70" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="note" value="低风险任务按策略自动推进；信息不足、持续失败、越界或中高风险操作进入人工检查点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8ED;strokeColor=#C6923A;fontFamily=Microsoft YaHei;fontColor=#6C501D;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1515" y="28" width="635" height="58" as="geometry"/></mxCell>

        <mxCell id="human-label" value="人工检查点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9A6A18;strokeColor=#9A6A18;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="175" height="105" as="geometry"/></mxCell>
        <mxCell id="human-band" value="目标与验收确认　　　　　　　　　　　　　　高风险需求 / 方案确认　　　　　　　　　　　　　　　　　　　　　　　　　交付、合并与发布审批" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8ED;strokeColor=#C6923A;fontFamily=Microsoft YaHei;fontColor=#6C501D;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="125" width="1910" height="105" as="geometry"/></mxCell>

        <mxCell id="execution-label" value="智能执行状态机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#233B53;strokeColor=#233B53;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="255" width="175" height="570" as="geometry"/></mxCell>
        <mxCell id="execution-band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E7F90;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="255" width="1910" height="570" as="geometry"/></mxCell>

        <mxCell id="s1" value="&lt;b&gt;1　建立任务契约&lt;/b&gt;&lt;br&gt;&lt;br&gt;解析目标、范围和验收标准&lt;br&gt;识别数据、权限和执行风险&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;任务单 · 风险等级 · 检查点&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#788B9C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#2B4156;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="280" y="300" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2　构建任务上下文&lt;/b&gt;&lt;br&gt;&lt;br&gt;通过受控连接层获取需求、代码、历史&lt;br&gt;合并测试、质量和运行信息&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;上下文包 · 信息缺口清单&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="750" y="300" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3　规划与 Agent 编排&lt;/b&gt;&lt;br&gt;&lt;br&gt;拆解步骤、依赖与完成条件&lt;br&gt;选择专业 Agent、模型和工具&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;可执行计划 · 质量阈值&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1220" y="300" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4　隔离环境执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;创建受控分支和执行沙箱&lt;br&gt;实施代码、配置与文档变更&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;候选变更集 · 决策记录&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1690" y="300" width="410" height="200" as="geometry"/></mxCell>

        <mxCell id="s5" value="&lt;b&gt;5　自动验证与修复&lt;/b&gt;&lt;br&gt;&lt;br&gt;执行测试、静态和安全检查&lt;br&gt;失败自动归因、修复和复测&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;测试报告 · 验证证据&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1690" y="570" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6　独立审查与整改&lt;/b&gt;&lt;br&gt;&lt;br&gt;审查正确性、安全、合规与影响&lt;br&gt;问题返回规划或执行环节整改&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;审查报告 · 整改结论&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1220" y="570" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7　证据化交付&lt;/b&gt;&lt;br&gt;&lt;br&gt;汇总合并请求、变更、测试和风险材料&lt;br&gt;人工审批后触发现有交付流程&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;获批交付包 · 发布状态&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEA;strokeColor=#B75E55;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#743C37;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="750" y="570" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;8　反馈与能力沉淀&lt;/b&gt;&lt;br&gt;&lt;br&gt;处理运行反馈、异常和新需求&lt;br&gt;更新知识、工作流技能、规则与评价任务&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;改进资产 · 下一轮任务&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#80659B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#574168;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="280" y="570" width="410" height="200" as="geometry"/></mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3E596E;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cycle" value="形成新任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#80659B;strokeWidth=1.8;dashed=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Microsoft YaHei;fontColor=#574168;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s8" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="670"/><mxPoint x="250" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="repair" value="验证失败：返回执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B75E55;strokeWidth=1.8;dashed=1;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=1;entryY=0.75;fontFamily=Microsoft YaHei;fontColor=#8A403A;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="s4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2125" y="620"/><mxPoint x="2125" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="review-back" value="审查失败：返回规划 / 执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B75E55;strokeWidth=1.8;dashed=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontFamily=Microsoft YaHei;fontColor=#8A403A;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s6" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="connection-label" value="受控调用与证据留痕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#365D73;strokeColor=#365D73;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="850" width="175" height="135" as="geometry"/></mxCell>
        <mxCell id="connection" value="&lt;b&gt;全过程按需连接：项目与知识　｜　代码仓库　｜　测试与 CI　｜　质量安全　｜　发布平台　｜　运行观测&lt;/b&gt;&lt;br&gt;每次调用记录：发起 Agent · 工具与参数 · 权限范围 · 输入输出摘要 · 执行状态 · 证据位置 · 人工审批结果&lt;br&gt;支持按任务回放核对资料版本、权限、测试、审查、失败回路和审批" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4EEF3;strokeColor=#557D91;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274B5E;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="240" y="850" width="1910" height="135" as="geometry"/></mxCell>
