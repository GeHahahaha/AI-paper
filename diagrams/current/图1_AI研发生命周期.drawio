        <mxCell id="gate0" value="目标、范围与风险确认" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F2F6FC;strokeColor=#003894;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontColor=#003894;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
