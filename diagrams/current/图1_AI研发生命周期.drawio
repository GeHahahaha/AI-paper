        </mxCell>
        <mxCell id="gate1" value="需求及验收标准确认" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F2F6FC;strokeColor=#003894;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontColor=#003894;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="354" y="132" width="270" height="32" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="&lt;b&gt;1  需求分析&lt;/b&gt;&lt;br&gt;&lt;br&gt;获取业务与项目上下文&lt;br&gt;澄清需求、约束与验收条件&lt;br&gt;标记来源、版本与信息缺口&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;产物：需求说明 / 验收标准&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
