        <mxCell id="pi-label" value="智能执行中枢" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#003894;strokeColor=#003894;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
