        <mxCell id="phase0" value="&lt;b&gt;0  任务受理&lt;/b&gt;&lt;br&gt;&lt;br&gt;明确目标、范围与优先级&lt;br&gt;完成风险分类与任务契约&lt;br&gt;确认责任人和审批策略&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#243447&quot;&gt;产物：任务单 / 风险等级&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E3F2;strokeWidth=2;fontFamily=Microsoft YaHei;fontColor=#243447;fontSize=18;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="180" width="270" height="225" as="geometry" />
