  <diagram id="pi-agent-orchestration" name="智能体编排架构">
    <mxGraphModel dx="1700" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="智能体编排架构" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;fontColor=#233B53;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="700" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="主控智能体维护智能任务状态与检查点，专业智能体按角色执行，通过结构化工件交接且不共享完整对话历史" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5F6F7F;" vertex="1" parent="1"><mxGeometry x="47" y="70" width="1800" height="30" as="geometry"/></mxCell>

        <mxCell id="input-label" value="任务输入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#53697B;strokeColor=#53697B;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="130" width="175" height="130" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;任务契约&lt;/b&gt;&lt;br&gt;目标 · 范围 · 验收标准 · 风险等级 · 责任人 · 审批策略 · 工具白名单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#788B9C;fontFamily=Microsoft YaHei;fontColor=#2B4156;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="1910" height="130" as="geometry"/></mxCell>

        <mxCell id="control-label" value="控制平面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#233B53;strokeColor=#233B53;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="285" width="175" height="235" as="geometry"/></mxCell>
        <mxCell id="main-agent" value="&lt;b&gt;主控智能体 / 智能任务状态机&lt;/b&gt;&lt;br&gt;任务规划与分派　｜　步骤状态与依赖控制　｜　检查点与人工升级&lt;br&gt;异常恢复与降级　｜　产物和证据汇总&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;正式项目状态与审批结论仍以既有研发平台为准&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#53697B;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontColor=#233B53;fontSize=16;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="665" y="305" width="1060" height="190" as="geometry"/></mxCell>
        <mxCell id="state" value="&lt;b&gt;结构化任务状态与工件索引&lt;/b&gt;&lt;br&gt;&lt;br&gt;任务上下文来源与版本&lt;br&gt;计划、依赖与完成条件&lt;br&gt;产物、证据与确认状态&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#5F6F7F&quot;&gt;不共享完整对话历史&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="305" width="385" height="190" as="geometry"/></mxCell>
        <mxCell id="policy" value="&lt;b&gt;策略、风险与模型路由&lt;/b&gt;&lt;br&gt;&lt;br&gt;风险分级与审批规则&lt;br&gt;工具和操作白名单&lt;br&gt;质量阈值与预算&lt;br&gt;模型选择、替换与降级" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1765" y="305" width="385" height="190" as="geometry"/></mxCell>
        <mxCell id="agent-bus" value="结构化交接与任务调度总线（传递确认工件、状态和证据，不传递完整对话历史）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#53697B;fontFamily=Microsoft YaHei;fontColor=#233B53;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="525" width="1910" height="28" as="geometry"/></mxCell>

        <mxCell id="agents-label" value="专业智能体池" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#315B3B;strokeColor=#315B3B;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="545" width="175" height="185" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;需求智能体&lt;/b&gt;&lt;br&gt;澄清需求&lt;br&gt;生成验收条件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="565" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;架构智能体&lt;/b&gt;&lt;br&gt;影响分析&lt;br&gt;方案与接口设计" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="565" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;b&gt;开发智能体&lt;/b&gt;&lt;br&gt;代码、配置和文档&lt;br&gt;小步提交与自检" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="565" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;b&gt;测试智能体&lt;/b&gt;&lt;br&gt;测试设计与执行&lt;br&gt;失败归因和复测" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1170" y="565" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="a5" value="&lt;b&gt;审查智能体 / 代码质量门禁&lt;/b&gt;&lt;br&gt;独立上下文 · 只读取确认工件&lt;br&gt;提交触发 / 定时全量扫描" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="565" width="290" height="145" as="geometry"/></mxCell>
