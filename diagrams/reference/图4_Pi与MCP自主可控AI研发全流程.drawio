        </mxCell>
        <mxCell id="subtitle" value="Pi 负责自主规划、执行、验证与复盘｜MCP 负责连接外部研发系统并实施受控交互｜人工保留目标、关键审批与异常决策责任" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5F6F7F;" vertex="1" parent="1">
          <mxGeometry x="47" y="68" width="2200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="definition" value="&lt;b&gt;自主可控&lt;/b&gt;：流程、知识、规则、数据、执行环境和审计记录由本方掌控；模型与工具可替换；自主程度与任务风险相匹配。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7F9;strokeColor=#9AA6B2;fontFamily=Microsoft YaHei;fontColor=#2B4156;fontSize=14;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2290" y="28" width="850" height="62" as="geometry"/>
        </mxCell>

