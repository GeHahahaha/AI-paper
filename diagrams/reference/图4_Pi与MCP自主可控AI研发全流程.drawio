        <mxCell id="pi-control" value="&lt;b&gt;主控 Agent / 状态机&lt;/b&gt;　任务编排 · 检查点控制 · 异常处理 · 结果汇总　　&lt;b&gt;共享任务状态&lt;/b&gt;　契约 · 上下文 · 计划 · 产物 · 证据 · 决策记录　　&lt;b&gt;专业 Agent 池&lt;/b&gt;　需求 · 架构 · 编码 · 测试 · 审查 · 发布 · 运维　　&lt;b&gt;策略与模型路由&lt;/b&gt;　风险策略 · 工具白名单 · 质量阈值 · 可替换模型" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7ECF1;strokeColor=#6E7F90;strokeWidth=1.2;fontFamily=Microsoft YaHei;fontColor=#233B53;fontSize=14;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="255" y="273" width="2865" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="loop-label" value="研发交付闭环" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontColor=#233B53;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="353" width="240" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="p0" value="&lt;b&gt;P0　任务受理与风险分级&lt;/b&gt;&lt;br&gt;&lt;br&gt;解析目标、范围与验收标准&lt;br&gt;识别数据、权限和执行风险&lt;br&gt;建立任务契约与审批策略&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：任务单 · 风险等级 · 责任人&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#788B9C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#2B4156;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="255" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;P1　上下文构建与项目认知&lt;/b&gt;&lt;br&gt;&lt;br&gt;经 MCP 读取需求、代码与历史&lt;br&gt;获取测试、变更和运行信息&lt;br&gt;建立任务上下文并识别缺口&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：上下文包 · 项目认知&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F6F8;strokeColor=#788B9C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#2B4156;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="575" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;P2　需求澄清与方案设计&lt;/b&gt;&lt;br&gt;&lt;br&gt;形成验收条件并处理业务歧义&lt;br&gt;开展变更影响与风险分析&lt;br&gt;设计架构、接口和数据方案&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：设计方案 · 验收用例&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="895" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;P3　任务规划与 Agent 编排&lt;/b&gt;&lt;br&gt;&lt;br&gt;拆解步骤、依赖和完成条件&lt;br&gt;选择专业 Agent、模型与工具&lt;br&gt;配置检查点、预算和降级策略&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：可执行计划 · 检查点&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="1215" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;P4　隔离环境实施&lt;/b&gt;&lt;br&gt;&lt;br&gt;创建受控分支与执行沙箱&lt;br&gt;修改代码、配置和研发文档&lt;br&gt;小步提交并记录决策依据&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：候选变更集&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="1535" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;P5　自动验证与失败修复&lt;/b&gt;&lt;br&gt;&lt;br&gt;单元、集成、静态与安全检查&lt;br&gt;失败自动归因、修复与复测&lt;br&gt;达到质量阈值或转人工处理&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：测试报告 · 证据包&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="1855" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;P6　独立审查与整改&lt;/b&gt;&lt;br&gt;&lt;br&gt;使用独立上下文开展 AI 审查&lt;br&gt;检查正确性、安全、合规与影响&lt;br&gt;问题返回设计或实施环节整改&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：审查报告 · 整改结论&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="2175" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;P7　人工审批与受控交付&lt;/b&gt;&lt;br&gt;&lt;br&gt;生成 PR、变更说明和回滚方案&lt;br&gt;汇总测试、审查与风险证据&lt;br&gt;审批后由 MCP 触发现有流水线&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：获批交付包&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDEDEA;strokeColor=#B75E55;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#743C37;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="2495" y="390" width="290" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="&lt;b&gt;P8　运行观察与持续学习&lt;/b&gt;&lt;br&gt;&lt;br&gt;获取健康、日志、指标和告警&lt;br&gt;辅助异常归因、处置与回归&lt;br&gt;复盘并更新组织级能力资产&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;color:#5F6F7F&quot;&gt;输出：运行证据 · 改进资产&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#80659B;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontColor=#574168;fontSize=14;align=left;verticalAlign=top;spacing=13;lineSpacing=4;" vertex="1" parent="1">
          <mxGeometry x="2815" y="390" width="290" height="270" as="geometry"/>
        </mxCell>

