        <mxCell id="h0" value="&lt;b&gt;目标与验收责任人&lt;/b&gt;&lt;br&gt;提出任务、确认范围与验收标准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C6923A;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#5E451B;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
