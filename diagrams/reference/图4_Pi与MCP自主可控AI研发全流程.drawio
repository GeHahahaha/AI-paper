        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;业务 / 架构确认&lt;/b&gt;&lt;br&gt;确认歧义、高风险需求与关键方案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C6923A;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#5E451B;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
