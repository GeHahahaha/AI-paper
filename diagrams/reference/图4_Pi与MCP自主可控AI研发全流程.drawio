        </mxCell>
        <mxCell id="human-label" value="人工责任与审批" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9A6A18;strokeColor=#9A6A18;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
