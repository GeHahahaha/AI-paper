        <mxCell id="h7" value="&lt;b&gt;合并与发布审批&lt;/b&gt;&lt;br&gt;核心代码合并、生产发布与回滚授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C6923A;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#5E451B;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2495" y="158" width="290" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h8" value="&lt;b&gt;异常与责任决策&lt;/b&gt;&lt;br&gt;处置重大异常、降级、终止与复盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C6923A;strokeWidth=1.3;fontFamily=Microsoft YaHei;fontColor=#5E451B;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
