        <mxCell id="title" value="Pi + MCP 自主可控 AI 研发全流程" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;fontColor=#233B53;" vertex="1" parent="1">
