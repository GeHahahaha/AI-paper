        <mxCell id="pi-label" value="Pi 自主研发中枢" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#233B53;strokeColor=#233B53;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="255" width="190" height="470" as="geometry"/>
