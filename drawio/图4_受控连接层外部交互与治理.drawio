  <diagram id="controlled-integration-governance" name="受控连接层外部交互与治理">
    <mxGraphModel dx="1700" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1050" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="受控连接层外部交互与治理" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=27;fontStyle=1;fontColor=#233B53;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="800" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="受控连接层不负责研发决策，而是把智能执行中枢的外部读写转化为标准化、最小权限、可审批、可审计的受控调用" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5F6F7F;" vertex="1" parent="1"><mxGeometry x="47" y="70" width="1800" height="30" as="geometry"/></mxCell>

        <mxCell id="caller" value="&lt;b&gt;主控 / 专业 Agent&lt;/b&gt;&lt;br&gt;提交结构化调用请求：任务、工具意图、参数、所需权限、预期结果与证据要求" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF4ED;strokeColor=#5E8B6B;strokeWidth=1.5;fontFamily=Microsoft YaHei;fontColor=#315B3B;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="240" y="125" width="1910" height="105" as="geometry"/></mxCell>
        <mxCell id="caller-label" value="调用发起方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#315B3B;strokeColor=#315B3B;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="125" width="175" height="105" as="geometry"/></mxCell>

        <mxCell id="gateway-label" value="受控调用链" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#365D73;strokeColor=#365D73;fontFamily=Microsoft YaHei;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="260" width="175" height="270" as="geometry"/></mxCell>
        <mxCell id="gateway-band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#557D91;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="1910" height="270" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;1　工具发现与选择&lt;/b&gt;&lt;br&gt;&lt;br&gt;按意图发现允许使用的工具&lt;br&gt;核验版本、能力和适用范围" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E4EEF3;strokeColor=#557D91;fontFamily=Microsoft YaHei;fontColor=#274B5E;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="270" y="305" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;2　身份与分级授权&lt;/b&gt;&lt;br&gt;&lt;br&gt;映射任务身份和责任人&lt;br&gt;按只读、普通写入、高风险写入分级" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="305" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;3　上下文与参数校验&lt;/b&gt;&lt;br&gt;&lt;br&gt;检查数据等级、字段、范围和格式&lt;br&gt;实施脱敏、最小化与读写白名单" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#BA7B2C;fontFamily=Microsoft YaHei;fontColor=#714A18;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="305" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="m4" value="&lt;b&gt;4　连接器受控执行&lt;/b&gt;&lt;br&gt;&lt;br&gt;从凭据系统获取短期凭据&lt;br&gt;在超时、资源和网络限制内执行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="305" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="m5" value="&lt;b&gt;5　结果标准化与校验&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一返回结构、状态和错误信息&lt;br&gt;校验完整性并定位证据位置" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF4F9;strokeColor=#5C86A5;fontFamily=Microsoft YaHei;fontColor=#274C66;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1510" y="305" width="285" height="170" as="geometry"/></mxCell>
        <mxCell id="m6" value="&lt;b&gt;6　审计与状态回写&lt;/b&gt;&lt;br&gt;&lt;br&gt;记录身份、工具、参数、结果和审批&lt;br&gt;向执行中枢与原系统回写任务状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#80659B;fontFamily=Microsoft YaHei;fontColor=#574168;fontSize=14;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1820" y="305" width="285" height="170" as="geometry"/></mxCell>

