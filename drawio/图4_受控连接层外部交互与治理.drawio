        <mxCell id="g1" value="&lt;b&gt;身份与凭据&lt;/b&gt;&lt;br&gt;身份映射 · 短期凭据&lt;br&gt;密钥不进入 Agent 上下文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F0F6;strokeColor=#9A789A;fontFamily=Microsoft YaHei;fontColor=#584058;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="850" width="440" height="135" as="geometry"/></mxCell>
