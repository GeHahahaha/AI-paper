        <mxCell id="execute" value="受控工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#557D91;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.577;entryY=0;fontFamily=Microsoft YaHei;fontColor=#274B5E;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4" target="connector-bus"><mxGeometry relative="1" as="geometry"/></mxCell>
